---
import Tag from './Tag.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';
import { slugify } from '../utils/slugify';
interface Props{
    title: string;
    tags: string[];
    company: string;
    landscapeImage: ImageMetadata;
    slug: string;
    tickets?: string;
}
const {title, tags, company, landscapeImage, tickets, slug: slug} = Astro.props;
const company_href = `/compannia/${slugify(company)}`;
const href = `/obras/${slug}`;
const inTheaters = !!tickets;
---

<div class="group flex flex-col relative bg-white/50 border border-brand-peach/30 rounded-lg overflow-hidden shadow-sm transition-all duration-300 hover:shadow-xl hover:-translate-y-1" class:list={[
    inTheaters && 'ring-2 ring-brand-red ring-offset-2 ring-offset-brand-bg'
  ]}>
  {inTheaters && (
    <a 
      href={tickets} 
      target="_blank" 
      rel="noopener noreferrer"
      class="
        absolute top-0 right-0 z-10
        bg-brand-red text-white 
        px-3 py-1
        rounded-bl-lg 
        font-sans font-bold text-base uppercase tracking-wider
        hover:bg-brand-dark-red
      "
    >
      EN CARTELERA
    </a>
  )}
    <a href={href} class="aspect-video block overflow-hidden">
        <Image src={landscapeImage} alt={`Imagen de ${title}`} width={800} height={450} quality={80} format="webp" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"/>
    </a>
    <div class="flex flex-col flex-1">
        <div class="p-4 flex flex-col flex-1 space-y-3">
            <a href={company_href} class="font-sans text-sm text-brand-text/80 uppercase tracking-wider hover:text-brand-red transition-colors w-fit font-semibold">{company}</a>
            <a href={href}>
                <h2 class="font-display text-xl text-brand-dark leading-tight line-clamp-2 hover:text-brand-red transition-colors">{title}</h2>
            </a>
            <div class="mt-auto pt-4">
                <div class="flex flex-wrap gap-2">
                    {tags.slice(0, 6).map((tag) => (<Tag tag_name={tag} />))}
                </div>
            </div>
        </div>
    </div>
</div>