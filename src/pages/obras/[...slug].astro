---
import { getCollection, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import MainLayout from "../../layouts/MainLayout.astro";
import Tag from "../../components/Tag.astro";
import "../../styles/global.css";
import { slugify } from '../../utils/slugify';
import { tagRecommendations } from '../../utils/tag-recommendations';

export async function getStaticPaths(){
    const obras = await getCollection("obras");
    return obras.map((obra) => ({
        params: { slug: obra.slug },
        props: { obra },
    }));
}

type Props = {
    obra: CollectionEntry<"obras">;
};
const { obra } = Astro.props;
const {data: frontmatter} = obra;

const { Content } = await obra.render()
const company_href = `/compannia/${slugify(frontmatter.company)}`;

const recommendations = frontmatter.tags
    .map(tag => tagRecommendations[tag])
    .filter(Boolean);
---

<MainLayout title={frontmatter.title}>

    <header class="relative w-full h-[60vh] md:h-[75vh] flex items-center justify-center">
        <Image src={frontmatter.image}
            alt={`Imagen de ${frontmatter.title}`}
            class="absolute inset-0 w-full h-full object-cover"
            widths={[400,800,1200]}
            sizes="(max-width: 800px) 100vw, 1200px"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-brand-bg via-brand-bg/50 to-transparent"></div>
        <h1 class="relative z-10 font-display text-5xl md:text-7xl text-brand-dark text-center px-4 drop-shadow-lg">
            {frontmatter.title}
        </h1>
        {frontmatter.tickets && (
            <a 
                href={frontmatter.tickets} 
                target="_blank" 
                rel="noopener noreferrer"
                class="
                    absolute bottom-6
                    bg-brand-red text-white 
                    px-8 py-3
                    rounded-lg 
                    font-sans font-bold text-lg uppercase tracking-wider
                    hover:bg-brand-dark-red transition-colors shadow-lg
                "
            >
                EN CARTELERA
            </a>
        )}
    </header>

    <div class="container mx-auto px-4 py-8 md:py-12">
            <a href="/lista" class="font-sans text-sm text-brand-red hover:text-brand-dark transition-colors inline-flex items-center gap-1 mb-8">&larr; Todas las obras</a>
            <section class="flex flex-wrap justify-between items-center gap-4 mb-8">
                <div class="flex flex-wrap gap-2">
                    {frontmatter.tags.map(tag => <Tag tag_name={tag} />)}
                </div>
                <a href={company_href} class="font-display text-2xl text-brand-dark hover:text-brand-red transition-colors">
                    {frontmatter.company}
                </a>
            </section>
            <section class="prose prose-lg max-w-none">
                {recommendations.length > 0 && (
                    <h1 class="font-display text-brand-dark">Recomendado a...</h1>
                    <ul>
                        {recommendations.map((rec) => (
                            <li>{rec}</li>
                        ))}
                    </ul>
                )}
                <Content />
            </section>
    </div>

</MainLayout>

<style is:global>
    .prose h1, .prose h2, .prose h3 {
        @apply font-display text-brand-dark;
    }
</style>
